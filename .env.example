# Base principale (dev). Avec infra/docker/compose.yml :
DATABASE_URL=postgres://dexlane:dexlane@localhost:5432/dexlane
# Base dédiée aux tests (recréée à chaque fichier de test — ne jamais pointer vers une vraie base)
TEST_DATABASE_URL=postgres://dexlane:dexlane@localhost:5432/dexlane_test

# API (apps/api). Jeton d'installation, au moins 24 caractères : openssl rand -hex 24. Il crée le premier compte
# (compte d'installation) et reste sa clé de secours ; le serveur web l'utilise pour appeler l'API.
DEXLANE_API_TOKEN=
# Écoute locale par défaut ; n'exposer que derrière un reverse proxy TLS ou un VPN.
HOST=127.0.0.1
PORT=8787
# Scan des cartes par Claude (POST /api/scans et banc d'essai)
ANTHROPIC_API_KEY=
# SCAN_MODEL=claude-opus-5-5

# Application web (apps/web) : adresse de l'API vue depuis le serveur Next.
# À placer dans apps/web/.env.local si elle diffère du défaut.
# DEXLANE_API_URL=http://127.0.0.1:8787

# Canal eBay (connecteur réel). Clés du portail développeur (developer.ebay.com › Application keys) :
# App ID → EBAY_CLIENT_ID, Cert ID → EBAY_CLIENT_SECRET ; RuName de « User tokens », dont l'adresse d'acceptation
# et de refus est <adresse de l'application>/settings/channels/ebay. Bac à sable tant que EBAY_ENV ≠ production.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_RU_NAME=
# EBAY_ENV=sandbox

# Forfaits (quota mensuel de cartes publiées, fonctionnalités par forfait). « off » : coupés pour toute l'installation,
# chaque compte sans limite (version Community auto-hébergée). Le compte d'installation n'a jamais de limite.
# DEXLANE_PLANS=off
# Adresse qui reçoit les demandes du support (Réglages › Support) ; sans elle, elles restent en base.
# SUPPORT_EMAIL=

# Comptes (BetterAuth). Secret de signature des sessions : openssl rand -base64 32. Sans lui, il est dérivé du jeton
# d'installation (changer le jeton déconnecterait alors tout le monde).
# BETTER_AUTH_SECRET=
# Adresse publique (liens des e-mails, sitemap, adresses canoniques). Sur Vercel : https://dexlane.app en production.
# DEXLANE_PUBLIC_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mails (inscription, vérification, mot de passe oublié, invitations) par Resend, depuis un domaine vérifié.
# Sans eux : e-mails écrits dans la console en développement, inscription refusée en production.
# RESEND_API_KEY=
# EMAIL_FROM=Dexlane <bonjour@dexlane.app>

# Tâches planifiées (/cron/*) : secret présenté par Vercel Cron.
# CRON_SECRET=
# Photos (Vercel Blob). Sans lui, les images scannées ne sont pas conservées.
# BLOB_READ_WRITE_TOKEN=

# Suivi des colis : La Poste (developer.laposte.fr) et Mondial Relay.
# LAPOSTE_OKAPI_KEY=
# MONDIAL_RELAY_ENSEIGNE=
# MONDIAL_RELAY_PRIVATE_KEY=

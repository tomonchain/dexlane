{
  "name": "@dexlane/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "build:vercel": "pnpm --filter @dexlane/db migrate --skip-if-unconfigured --not-on-preview && NEXT_TELEMETRY_DISABLED=1 next build",
    "i18n": "tsx scripts/i18n-check.ts",
    "test": "tsx scripts/i18n-check.ts"
  },
  "dependencies": {
    "@dexlane/api": "workspace:*",
    "@dexlane/catalog": "workspace:*",
    "@dexlane/db": "workspace:*",
    "@dexlane/inventory": "workspace:*",
    "@dexlane/listings": "workspace:*",
    "@dexlane/pricing": "workspace:*",
    "@dexlane/scan": "workspace:*",
    "@tailwindcss/postcss": "^4.3.5",
    "@techstark/opencv-js": "5.0.0-release.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "geist": "^1.9.2",
    "hono": "^4.13.18",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.8",
    "@playwright/test": "1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

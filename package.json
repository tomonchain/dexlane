{
  "name": "dexlane",
  "private": true,
  "version": "0.9.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:migrate": "pnpm --filter @dexlane/db migrate",
    "api": "pnpm --filter @dexlane/api start",
    "web": "pnpm --filter @dexlane/web dev",
    "e2e": "pnpm --filter @dexlane/web e2e",
    "test": "pnpm -r test",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @dexlane/web typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
